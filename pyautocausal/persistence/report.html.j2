{% extends 'lab/index.html.j2' %}

{% block html_head_css %}
{{ super() }}
<style id="pyautocausal-report-style">
body.jp-Notebook {
  --jp-content-font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --jp-content-font-size1: 16px;
  --jp-content-line-height: 1.65;
  --jp-content-font-color1: #334155;
  --jp-content-link-color: #0f766e;
  margin: 0 auto;
  max-width: 1080px;
  padding: 40px clamp(16px, 4vw, 40px) 72px;
  background: #fff;
}
.jp-Notebook main { min-width: 0; }
.jp-Notebook .jp-Cell { padding: 8px 0; }
.jp-Notebook .jp-RenderedHTMLCommon h1 {
  color: #0f172a;
  font-size: 2.2em;
  line-height: 1.2;
  letter-spacing: -0.03em;
  margin-bottom: 0.6em;
}
.jp-Notebook .jp-RenderedHTMLCommon h2 {
  color: #0f766e;
  border-bottom: 1px solid #e2e8f0;
  padding-bottom: 0.5em;
  margin-top: 1.6em;
}
.jp-Notebook .jp-RenderedHTMLCommon h3 { color: #334155; }
.jp-Notebook .jp-RenderedHTMLCommon a { text-underline-offset: 3px; }
.jp-Notebook .pac-table-wrap { overflow-x: auto; }
.jp-Notebook .pac-table-wrap table.pac-table {
  width: max-content;
  min-width: 100%;
  table-layout: auto;
}
.jp-Notebook .pac-table-wrap th,
.jp-Notebook .pac-table-wrap td { white-space: nowrap; }
.jp-Notebook .pac-notice {
  border-left: 3px solid #0f766e;
  background: #f0fdfa;
  padding: 12px 18px;
  margin: 16px 0;
}
.jp-Notebook .jp-RenderedHTMLCommon blockquote {
  border-left: 3px solid #0f766e;
  background: #f0fdfa;
  color: #334155;
  padding: 12px 18px;
  margin: 16px 0;
}
.jp-Notebook .jp-RenderedHTMLCommon table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9em;
  font-variant-numeric: tabular-nums;
}
.jp-Notebook .jp-RenderedHTMLCommon th,
.jp-Notebook .jp-RenderedHTMLCommon td {
  padding: 9px 12px;
  border-bottom: 1px solid #e2e8f0;
  text-align: right;
}
.jp-Notebook .jp-RenderedHTMLCommon th:first-child,
.jp-Notebook .jp-RenderedHTMLCommon td:first-child { text-align: left; }
.jp-Notebook .jp-RenderedHTMLCommon thead {
  color: #0f172a;
  background: #f1f5f9;
}
.jp-Notebook .jp-RenderedHTMLCommon tbody tr:nth-child(even) { background: #f8fafc; }
.jp-Notebook .jp-RenderedHTMLCommon details {
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  padding: 12px 16px;
  margin: 12px 0;
}
.jp-Notebook .jp-RenderedHTMLCommon summary { cursor: pointer; color: #0f766e; }
.jp-Notebook .jp-InputArea-editor { border-radius: 6px; border-color: #e2e8f0; }
.jp-Notebook .jp-InputPrompt, .jp-Notebook .jp-OutputPrompt { color: #64748b; }
.jp-Notebook .jp-OutputArea-output img,
.jp-Notebook .jp-RenderedHTMLCommon img { max-width: 100%; height: auto; }
@media (max-width: 640px) {
  body.jp-Notebook { padding-top: 20px; }
  .jp-Notebook .jp-InputPrompt, .jp-Notebook .jp-OutputPrompt { display: none; }
  .jp-Notebook .jp-RenderedHTMLCommon h1 { font-size: 1.8em; }
  .jp-Notebook .jp-RenderedHTMLCommon { overflow-x: auto; }
}
@media print {
  body.jp-Notebook { max-width: none; padding: 0; font-size: 11pt; }
  .jp-Notebook .jp-RenderedHTMLCommon h2,
  .jp-Notebook .jp-RenderedHTMLCommon h3 { break-after: avoid; }
  .jp-Notebook .jp-OutputArea-output img,
  .jp-Notebook .jp-RenderedHTMLCommon table { break-inside: avoid; }
  .jp-Notebook .jp-InputPrompt, .jp-Notebook .jp-OutputPrompt { display: none; }
}
</style>
{% endblock html_head_css %}
